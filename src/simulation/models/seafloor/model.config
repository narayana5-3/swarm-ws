<?xml version="1.0"?>
<model>
  <name>seafloor</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Narayana Panda</name>
    <email>narayanapanda10@gmail.com</email>
  </author>
  <description>
    Static seafloor with a real PBR sandy-seabed texture (albedo/normal/
    roughness, sourced from Fuel's "Ocean Floor Texture" by OpenRobotics,
    downsampled from 8K to 1024px for real-time rendering). Box geometry
    (not an SDF plane) -- a mathematically infinite plane crashed the
    dartsim collision detector here, see ocean.sdf's own history/comments.
  </description>
</model>
