<?xml version="1.0"?>
<sdf version="1.9">
  <model name="seafloor">
    <static>true</static>
    <link name="seafloor_link">
      <collision name="seafloor_collision">
        <geometry>
          <box>
            <size>200 200 2</size>
          </box>
        </geometry>
      </collision>
      <visual name="seafloor_visual">
        <geometry>
          <box>
            <size>200 200 2</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.55 0.45 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/OceanFloor_Albedo.png</albedo_map>
              <normal_map>materials/textures/OceanFloor_Normal.png</normal_map>
              <roughness_map>materials/textures/OceanFloor_Roughness.png</roughness_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
