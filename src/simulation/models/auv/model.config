<?xml version="1.0"?>
<model>
  <name>auv</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Narayana Panda</name>
    <email>narayanapanda10@gmail.com</email>
  </author>
  <description>
    BlueROV2-style box-hull AUV: 5 axis-aligned thrusters (2 surge/yaw, 1 sway,
    2 heave), forward camera, and a gpu_lidar sensor configured as a
    forward-looking-sonar substitute (narrow vertical / wide horizontal fan,
    1-40m range) reshaped downstream into occupancy_mapping.py's expected
    [range_bin, azimuth_bin] sonar array format. Spawned multiple times with
    a distinct model name (auv0/auv1/auv2) so all plugin/sensor topics,
    which resolve relative to the spawned model's own scoped name, stay
    per-instance without needing per-copy edits.
  </description>
</model>
