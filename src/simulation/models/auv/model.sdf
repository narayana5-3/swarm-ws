<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="auv">
    <!-- Box hull, sized so mass and buoyancy plugin's displaced volume
         (collision box x fluid density) are consistent: 0.5x0.35x0.25m =
         0.04375 m^3 -> neutral mass would be 43.75kg at 1000 kg/m^3; mass
         is set ~2% above that for a gentle, easily-trimmed negative
         buoyancy (real ROV practice) instead of the wildly mismatched
         11kg-in-a-0.072m^3-box first attempt, which produced ~600N of net
         upward force and sent the vehicle rocketing to the surface (caught
         by checking real odometry after spawn, not assumed from the SDF
         alone -- see M1 verification notes). -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <!-- CG offset 8cm below the link origin (which is also the
             collision box's geometric center = center of buoyancy, since
             Buoyancy computes its centroid from the collision geometry).
             Without this offset, CG and CB coincide, there's zero
             metacentric righting moment, and the vehicle has no passive
             roll/pitch stability -- confirmed empirically: with CG=CB the
             spawned AUVs settled at essentially random tumbled
             orientations (~155 degrees off upright) despite stable
             position. A real ROV gets this from heavy ballast low / foam
             buoyancy high; this offset reproduces that passively. -->
        <pose>0 0 -0.11 0 0 0</pose>
        <mass>44.6</mass>
        <inertia>
          <ixx>0.6876</ixx>
          <iyy>1.1615</iyy>
          <izz>1.3846</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="hull_collision">
        <geometry>
          <box>
            <size>0.5 0.35 0.25</size>
          </box>
        </geometry>
      </collision>
      <visual name="hull_visual">
        <geometry>
          <box>
            <size>0.5 0.35 0.25</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.5 0.05 1</ambient>
          <diffuse>1.0 0.6 0.1 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <!-- Forward-facing RGB camera. Relative (non-absolute) topic name so
           gz-sim scopes it under this model's own instance path -- verify
           the real resolved topic with `gz topic -l` after spawning rather
           than assuming, per-instance names are confirmed at launch time. -->
      <sensor name="front_camera" type="camera">
        <pose>0.26 0 0 0 0 0</pose>
        <topic>__AUV_NAME__/camera</topic>
        <update_rate>15</update_rate>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>50</far>
          </clip>
        </camera>
      </sensor>

      <!-- gpu_lidar reshaped downstream (in the occupancy_mapping ROS2 node,
           not here) into a fake forward-looking-sonar [range_bin, azimuth_bin]
           array: wide horizontal fan (120 deg, matches SONAR_AZIMUTH_FOV_DEG
           in occupancy_mapping.py), narrow vertical fan (20 deg, matches that
           module's documented elevation-ignored assumption), 1-40m range
           (matches SONAR_RANGE_MIN/MAX). -->
      <sensor name="fls_sonar" type="gpu_lidar">
        <pose>0.26 0 -0.04 0 0 0</pose>
        <topic>__AUV_NAME__/sonar</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>64</samples>
              <resolution>1</resolution>
              <min_angle>-1.0472</min_angle>
              <max_angle>1.0472</max_angle>
            </horizontal>
            <vertical>
              <samples>4</samples>
              <resolution>1</resolution>
              <min_angle>-0.1745</min_angle>
              <max_angle>0.1745</max_angle>
            </vertical>
          </scan>
          <range>
            <min>1.0</min>
            <max>40.0</max>
            <resolution>0.05</resolution>
          </range>
        </lidar>
      </sensor>
    </link>

    <!-- ============================================================
         Thrusters: 5 axis-aligned (no 45-degree vectoring needed):
           surge_left / surge_right -> differential = surge + yaw
           sway                     -> pure lateral
           heave_front / heave_rear -> differential = heave + pitch trim
         Each is a tiny near-massless propeller link on a revolute joint
         whose axis is the thrust direction, driven by gz-sim-thruster-system
         (cmd_thrust topic takes the desired force in Newtons directly).
         ============================================================ -->

    <link name="prop_surge_left">
      <pose>-0.2 0.13 0 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
                  <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="prop_surge_left_visual">
        <geometry><cylinder><radius>0.04</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient></material>
      </visual>
    </link>
    <joint name="surge_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>prop_surge_left</child>
      <axis>
        <xyz>1 0 0</xyz>
      </axis>
    </joint>

    <link name="prop_surge_right">
      <pose>-0.2 -0.13 0 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
                  <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="prop_surge_right_visual">
        <geometry><cylinder><radius>0.04</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient></material>
      </visual>
    </link>
    <joint name="surge_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>prop_surge_right</child>
      <axis>
        <xyz>1 0 0</xyz>
      </axis>
    </joint>

    <link name="prop_sway">
      <pose>0 0 0.015 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
                  <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="prop_sway_visual">
        <geometry><cylinder><radius>0.04</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient></material>
      </visual>
    </link>
    <joint name="sway_joint" type="revolute">
      <parent>base_link</parent>
      <child>prop_sway</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <link name="prop_heave_front">
      <pose>0.15 0 0.04 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
                  <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="prop_heave_front_visual">
        <geometry><cylinder><radius>0.04</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient></material>
      </visual>
    </link>
    <joint name="heave_front_joint" type="revolute">
      <parent>base_link</parent>
      <child>prop_heave_front</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <link name="prop_heave_rear">
      <pose>-0.15 0 0.04 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
                  <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="prop_heave_rear_visual">
        <geometry><cylinder><radius>0.04</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient></material>
      </visual>
    </link>
    <joint name="heave_rear_joint" type="revolute">
      <parent>base_link</parent>
      <child>prop_heave_rear</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- ============================================================
         Physics plugins. Buoyancy is world-level (ocean.sdf). These are
         embedded directly in the model (rather than attached at each
         <include> site) so every spawned instance auto-resolves its own
         topics/links against its own runtime model name with zero extra
         per-instance config.
         ============================================================ -->

    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>surge_left_joint</joint_name>
      <thrust_coefficient>0.004422</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
    </plugin>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>surge_right_joint</joint_name>
      <thrust_coefficient>0.004422</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
    </plugin>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>sway_joint</joint_name>
      <thrust_coefficient>0.004422</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
    </plugin>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>heave_front_joint</joint_name>
      <thrust_coefficient>0.004422</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
    </plugin>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>heave_rear_joint</joint_name>
      <thrust_coefficient>0.004422</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
    </plugin>

    <!-- Added-mass / drag coefficients hand-picked for the ~44.6kg box hull
         above at low (<1 m/s) speed -- NOT CFD-derived, scaled from the
         reference Tethys values found in /usr/share/gz/gz-sim8/worlds/
         auv_controls.sdf (tuned for a much larger torpedo hull) so this
         vehicle is responsive to tens-of-Newtons thrust commands instead of
         over- or under-damped.

         kDotP/mDotQ/nDotR (rotational added mass) MUST stay well below this
         link's real moments of inertia (ixx=0.6876, iyy=1.1615, izz=1.3846
         above) -- an earlier attempt at -0.2/-1.2/-1.2 (mDotQ/nDotR close to
         or exceeding the real iyy/izz) made the effective inertia matrix
         used by the constraint solver nearly singular and crashed the
         physics engine on the very first step (isolated by bisecting a
         standalone test model down to just this plugin: real translational
         coefficients + real rotational drag were both independently fine,
         only the rotational added-mass terms at that magnitude aborted the
         server). Keep these under ~15% of the corresponding real inertia. -->
    <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <xDotU>-8.0</xDotU>   <yDotV>-12.0</yDotV>  <zDotW>-12.0</zDotW>
      <kDotP>-0.05</kDotP>  <mDotQ>-0.15</mDotQ>  <nDotR>-0.15</nDotR>
      <xUabsU>-40.0</xUabsU> <xU>-8.0</xU>
      <yVabsV>-70.0</yVabsV> <yV>-12.0</yV>
      <zWabsW>-70.0</zWabsW> <zW>-12.0</zW>
      <kPabsP>-0.2</kPabsP>  <kP>-0.08</kP>
      <mQabsQ>-6.0</mQabsQ>  <mQ>-1.5</mQ>
      <nRabsR>-6.0</nRabsR>  <nR>-1.5</nR>
    </plugin>

    <!-- Ground-truth pose/velocity as nav_msgs/Odometry-compatible
         gz.msgs.Odometry on /model/<name>/odometry (bare relative topic,
         auto-scoped per spawned instance name). Needed both to verify real
         spawn pose (per the "probe, don't assume" lesson from swarm_sim.py)
         and as the position feed for occupancy/task-allocation nodes later. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
