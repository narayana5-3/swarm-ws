<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="dam_structure">
    <static>true</static>

    <link name="dam_wall">
      <pose>0 -30 -20 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>1.0</ixx><iyy>1.0</iyy><izz>1.0</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="dam_wall_collision">
        <geometry>
          <box>
            <size>80 4 60</size>
          </box>
        </geometry>
      </collision>
      <visual name="dam_wall_visual">
        <geometry>
          <box>
            <size>80 4 60</size>
          </box>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.5 1</ambient>
          <diffuse>0.6 0.6 0.55 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <!-- Pipeline section running away from the dam face for the AUVs to
         inspect along its length, in addition to the wall face. -->
    <link name="pipe_section">
      <pose>15 -8 -40 -1.5708 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>1.0</ixx><iyy>1.0</iyy><izz>1.0</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="pipe_collision">
        <geometry>
          <cylinder>
            <radius>2</radius>
            <length>40</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="pipe_visual">
        <geometry>
          <cylinder>
            <radius>2</radius>
            <length>40</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.35 0.35 0.4 1</ambient>
          <diffuse>0.4 0.4 0.45 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
