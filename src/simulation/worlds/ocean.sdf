<?xml version="1.0" ?>
<sdf version="1.9">

<world name="ocean">

    <physics name="physics" type="ode">
        <max_step_size>0.004</max_step_size>
        <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
        filename="gz-sim-physics-system"
        name="gz::sim::systems::Physics"/>

    <plugin
        filename="gz-sim-scene-broadcaster-system"
        name="gz::sim::systems::SceneBroadcaster"/>

    <plugin
        filename="gz-sim-user-commands-system"
        name="gz::sim::systems::UserCommands"/>

    <plugin
        filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Applies to every included model with a <buoyancy> tag or collision
         volume -- AUVs spawned into this world (see models/auv/) get their
         buoyancy from this single world-level plugin, not per-model. -->
    <plugin
        filename="gz-sim-buoyancy-system"
        name="gz::sim::systems::Buoyancy">
        <uniform_fluid_density>1000</uniform_fluid_density>
    </plugin>

    <light name="sun" type="directional">
        <cast_shadows>true</cast_shadows>
        <pose>0 0 100 0 0 0</pose>

        <diffuse>1 1 1 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>

        <direction>-0.5 0.1 -1</direction>
    </light>

    <scene>
        <ambient>0.15 0.28 0.35 1</ambient>
        <background>0.02 0.18 0.28 1</background>
        <!-- Underwater murk: real oceans/reservoirs attenuate visibility to
             a few tens of meters, not the crisp infinite-visibility default
             -- fog fades distant geometry into the background color instead
             of everything looking equally sharp regardless of range, which
             otherwise reads as "a dry-land scene with blue paint," not water. -->
        <fog>
            <color>0.05 0.22 0.3 1</color>
            <type>exp2</type>
            <density>0.018</density>
            <start>2</start>
            <end>45</end>
        </fog>
        <grid>false</grid>
    </scene>

    <!-- Seafloor: a large flat BOX, not an SDF <plane> -- a mathematically
         infinite plane geometry crashed the dartsim/ODE collision detector
         here with "ODE INTERNAL ERROR 1: assertion aabbBound >= dMinIntExact"
         (confirmed by isolating: removed everything else down to a single
         AUV and it still aborted within the first physics step; switching
         this to a finite box fixed it). Top face sits at z=-50 to match
         ENV_MIN in occupancy_mapping.py / damage_probability_mapping.py, so
         the risk grid's covered volume matches where the swarm actually
         operates (water surface near z=0 down to the seafloor at z=-50).
         Moved into its own models/seafloor/ package (see that model's own
         model.config) so it can carry a real PBR sandy-seabed texture
         instead of a flat material color -- resolved the same way as
         dam_structure, via GZ_SIM_RESOURCE_PATH, so it stays fully local
         (no network access needed at demo time). -->
    <include>
        <uri>model://seafloor</uri>
        <pose>0 0 -51 0 0 0</pose>
    </include>

    <!-- Dam wall + pipeline section the swarm inspects (see
         models/dam_structure/). Resolved via GZ_SIM_RESOURCE_PATH, which the
         launch file points at this package's models/ directory. -->
    <include>
        <uri>model://dam_structure</uri>
        <pose>0 0 0 0 0 0</pose>
    </include>

</world>

</sdf>
