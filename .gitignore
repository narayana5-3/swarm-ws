# colcon build artifacts (regenerated by `colcon build`)
/build/
/install/
/log/

# Python
__pycache__/
*.pyc
*.egg-info/
/venv/

# Runtime output from launching the stack (occupancy/damage snapshots, etc.)
/live_run/
/verify_run/

# Convenience copy of trained checkpoints at workspace root
# (the source of truth lives in src/damage_detection/checkpoints/)
/checkpoints/

# Windows/WSL download marker files
*:Zone.Identifier
